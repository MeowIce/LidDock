<Window x:Class="LidDock.App.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LidDock Diagnostics" Height="680" Width="860"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Hardware Telemetry &amp; Diagnostics" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Real-time system sensor observation, display topology and event trace logs."
                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource FluentCard}" Margin="0,0,0,16">
            <UniformGrid Columns="3">
                <StackPanel Margin="8">
                    <TextBlock Text="Clamshell State" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding formattedClamshellState}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Margin="8">
                    <TextBlock Text="Lid Sensor Position" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding formattedLidState}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Margin="8">
                    <TextBlock Text="Power Source" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding formattedPowerSource}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Margin="8">
                    <TextBlock Text="Battery Remaining" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding batteryPercent, StringFormat='{}{0}%'}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Margin="8">
                    <TextBlock Text="Connected Displays" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding displaysSummary}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Margin="8">
                    <TextBlock Text="Windows Lid Close Action" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding powerPlanSummary}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource FluentCard}" Margin="0,0,0,14" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Detected Display Topology" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <ListView Grid.Row="1" ItemsSource="{Binding displaysList}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Monitor Name" DisplayMemberBinding="{Binding friendlyName}" Width="220"/>
                            <GridViewColumn Header="Technology" DisplayMemberBinding="{Binding formattedTechnology}" Width="160"/>
                            <GridViewColumn Header="Internal" DisplayMemberBinding="{Binding isInternal}" Width="80"/>
                            <GridViewColumn Header="Virtual" DisplayMemberBinding="{Binding isVirtual}" Width="80"/>
                            <GridViewColumn Header="Hardware Device Path" DisplayMemberBinding="{Binding devicePath}" Width="280"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource FluentCard}" Margin="0,0,0,16" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Live Event Trace Log" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <ListView Grid.Row="1" ItemsSource="{Binding logEntries}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Timestamp" DisplayMemberBinding="{Binding timestamp, StringFormat='HH:mm:ss.fff'}" Width="130"/>
                            <GridViewColumn Header="Level" DisplayMemberBinding="{Binding level}" Width="80"/>
                            <GridViewColumn Header="Event Details" DisplayMemberBinding="{Binding message}" Width="590"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Refresh Sensors" Width="130" Margin="0,0,10,0" Click="onRefreshClicked" Style="{StaticResource FluentSecondaryButton}"/>
            <Button Content="Export Snapshot" Width="130" Margin="0,0,10,0" Click="onExportClicked" Style="{StaticResource FluentSecondaryButton}"/>
            <Button Content="Close" Width="100" Click="onCloseClicked" Style="{StaticResource FluentPrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
