<Window x:Class="LidDock.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LidDock Settings" Height="640" Width="720"
        MinHeight="580" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ResizeMode="CanResize"
        Icon="pack://application:,,,/Assets/app.ico">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="-1"
                      CornerRadius="8"
                      UseAeroCaptionButtons="True"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Grid Margin="20,12,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,4,140,16">
            <Image Source="pack://application:,,,/Assets/LidDock.png" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="LidDock Settings" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="Manage Clamshell mode, display triggers, safety timers and power behavior."
                           FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <TabControl Grid.Row="1" Style="{StaticResource FluentTabControl}">
            <TabItem Header="General">
                <ScrollViewer Style="{StaticResource FluentTabScrollViewer}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FluentTabDescription}"
                                   Text="Core controls: turn LidDock on and decide whether it starts with Windows."/>
                        <Border Style="{StaticResource FluentCard}">
                            <CheckBox Content="Use LidDock"
                                      IsChecked="{Binding enableClamshell}"
                                      Style="{StaticResource FluentToggleSwitch}"
                                      FontWeight="Medium"/>
                        </Border>
                        <Border Style="{StaticResource FluentCard}">
                            <StackPanel>
                                <CheckBox Content="Start with Windows"
                                          IsChecked="{Binding startWithWindows}"
                                          Style="{StaticResource FluentToggleSwitch}"
                                          FontWeight="Medium"/>
                                <TextBlock Text="Run LidDock automatically on system startup and minimize to the system tray."
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,48,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Profiles">
                <ScrollViewer Style="{StaticResource FluentTabScrollViewer}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FluentTabDescription}"
                                   Text="Pick when clamshell mode should apply. Presets cover common setups; Custom exposes the rules."/>
                        <RadioButton GroupName="Profiles"
                                     IsChecked="{Binding isProfileSmartDocked}"
                                     Style="{StaticResource FluentRadioCard}">
                            <StackPanel>
                                <TextBlock Text="Smart Docked (Recommended)"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Clamshell mode activates automatically when docked and switches back to normal sleep when undocked."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="Profiles"
                                     IsChecked="{Binding isProfileAcOnly}"
                                     Style="{StaticResource FluentRadioCard}">
                            <StackPanel>
                                <TextBlock Text="AC Power Only"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Clamshell mode is strictly restricted to wall power connection to preserve battery health."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="Profiles"
                                     IsChecked="{Binding isProfileAlwaysClamshell}"
                                     Style="{StaticResource FluentRadioCard}">
                            <StackPanel>
                                <TextBlock Text="Always Clamshell"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Clamshell mode remains active whenever an external monitor is attached, even on battery."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="Profiles"
                                     IsChecked="{Binding isProfileCustom}"
                                     Style="{StaticResource FluentRadioCard}">
                            <StackPanel>
                                <TextBlock Text="Custom"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Define your own rules: choose whether AC power is required and the battery level that disengages clamshell mode."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </RadioButton>

                        <Border IsEnabled="{Binding isProfileCustom}"
                                ClipToBounds="True"
                                Margin="16,8,0,0">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource FluentCard}">
                                    <Setter Property="MaxHeight" Value="0"/>
                                    <Setter Property="Opacity" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding isProfileCustom}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                         To="280"
                                                                         Duration="0:0:0.25">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseOut"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="1"
                                                                         Duration="0:0:0.25"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="MaxHeight"
                                                                         To="0"
                                                                         Duration="0:0:0.2">
                                                            <DoubleAnimation.EasingFunction>
                                                                <CubicEase EasingMode="EaseIn"/>
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         To="0"
                                                                         Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <CheckBox Content="Require AC Power"
                                          IsChecked="{Binding customRequireAcPower}"
                                          Style="{StaticResource FluentToggleSwitch}"
                                          FontWeight="Medium"/>
                                <TextBlock Text="When enabled, clamshell mode is active only while the laptop is plugged in. The battery threshold below applies when this is off."
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,48,0" TextWrapping="Wrap"/>
                                <StackPanel IsEnabled="{Binding isCustomThresholdEnabled}" Margin="0,16,0,0">
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="Minimum Battery Threshold for Clamshell" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding minimumBatteryThreshold, StringFormat='{}{0}%'}"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                                   DockPanel.Dock="Right" TextAlignment="Right"/>
                                    </DockPanel>
                                    <Slider Minimum="5" Maximum="50" SmallChange="1" LargeChange="5"
                                            Value="{Binding minimumBatteryThreshold}"
                                            Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="{Binding batteryThresholdNote}"
                                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Display Detection">
                <ScrollViewer Style="{StaticResource FluentTabScrollViewer}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FluentTabDescription}"
                                   Text="Choose which connected displays count as a dock and can trigger clamshell mode."/>
                        <Border Style="{StaticResource FluentCard}">
                            <StackPanel>
                                <CheckBox Content="Require External Display"
                                          IsChecked="{Binding requireExternalDisplay}"
                                          Style="{StaticResource FluentToggleSwitch}"/>
                                <TextBlock Text="{Binding externalDisplayNote}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,48,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource FluentCard}">
                            <CheckBox Content="Ignore Virtual Displays (RDP, Parsec, Virtual Drivers)"
                                      IsChecked="{Binding ignoreVirtualDisplays}"
                                      Style="{StaticResource FluentToggleSwitch}"/>
                        </Border>
                        <Border Style="{StaticResource FluentCard}">
                            <CheckBox Content="Ignore Wireless Displays (Miracast)"
                                      IsChecked="{Binding ignoreWirelessDisplays}"
                                      Style="{StaticResource FluentToggleSwitch}"/>
                        </Border>
                        <Border Style="{StaticResource FluentCard}">
                            <StackPanel>
                                <CheckBox Content="Only trigger on selected displays"
                                          IsChecked="{Binding onlySelectedDisplaysTrigger}"
                                          Style="{StaticResource FluentToggleSwitch}"/>
                                <TextBlock Text="{Binding displaySelectionNote}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,48,0" TextWrapping="Wrap"/>
                                <StackPanel x:Name="displaySelectionPanel" MaxHeight="0" ClipToBounds="True">
                                    <StackPanel x:Name="displaySelectionContent">
                                        <ItemsControl ItemsSource="{Binding detectedDisplays}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Style="{StaticResource FluentToggleSwitch}" IsChecked="{Binding isChecked}">
                                                        <StackPanel Margin="0,4">
                                                            <TextBlock Text="{Binding displayName}"/>
                                                            <TextBlock Text="{Binding subtitle}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </CheckBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="No external display connected."
                                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"
                                                   Visibility="{Binding hasNoDetectedDisplays, Converter={StaticResource BoolToVisConverter}}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Safety &amp; Delay">
                <ScrollViewer Style="{StaticResource FluentTabScrollViewer}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FluentTabDescription}"
                                   Text="Set the grace period and battery protection used before the laptop is allowed to sleep."/>
                        <Border Style="{StaticResource FluentCard}">
                            <CheckBox Content="Sleep laptop if display or charger disconnects while lid is closed"
                                      IsChecked="{Binding sleepOnDisconnectWithLidClosed}"
                                      Style="{StaticResource FluentToggleSwitch}"/>
                        </Border>

                        <Border Style="{StaticResource FluentCard}" IsEnabled="{Binding isDisconnectDelayEnabled}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Disconnect Grace Delay" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding disconnectDelaySeconds, StringFormat='{}{0} seconds'}"
                                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                               DockPanel.Dock="Right" TextAlignment="Right"/>
                                </DockPanel>
                                <Slider Minimum="3" Maximum="30" SmallChange="1" LargeChange="5"
                                        Value="{Binding disconnectDelaySeconds}"
                                        Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{Binding disconnectDelayNote}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource FluentCard}" IsEnabled="{Binding isBatteryThresholdEnabled}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Minimum Battery Threshold for Clamshell" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding minimumBatteryThreshold, StringFormat='{}{0}%'}"
                                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                               DockPanel.Dock="Right" TextAlignment="Right"/>
                                </DockPanel>
                                <Slider Minimum="5" Maximum="50" SmallChange="1" LargeChange="5"
                                        Value="{Binding minimumBatteryThreshold}"
                                        Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{Binding safetyBatteryThresholdNote}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Amphetawin">
                <ScrollViewer Style="{StaticResource FluentTabScrollViewer}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FluentTabDescription}"
                                   Text="Keep the laptop awake on demand, or automatically while a chosen app is running."/>

                        <Border Style="{StaticResource FluentCard}">
                            <StackPanel>
                                <CheckBox Content="Amphetawin"
                                          IsChecked="{Binding amphetawinEnabled}"
                                          Style="{StaticResource FluentToggleSwitch}"/>
                                <TextBlock Text="Amphetawin Duration" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,12,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Text="{Binding amphetawinDurationValue, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource FluentTextBox}"
                                             Width="76"
                                             IsEnabled="{Binding amphetawinTimed}"
                                             VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding durationUnitOptions}"
                                              SelectedItem="{Binding amphetawinDurationUnit, Mode=TwoWay}"
                                              Style="{StaticResource FluentComboBox}"
                                              Width="120"
                                              IsEnabled="{Binding amphetawinTimed}"
                                              Margin="8,0,0,0"/>
                                    <CheckBox Content="Infinite"
                                              IsChecked="{Binding amphetawinInfinite}"
                                              Style="{StaticResource FluentCheckBox}"
                                              Margin="16,0,0,0"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding amphetawinNote}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource FluentCard}">
                            <StackPanel>
                                <CheckBox Content="Start Amphetawin automatically with an app"
                                          IsChecked="{Binding autoAmphetawinEnabled}"
                                          Style="{StaticResource FluentToggleSwitch}"
                                          FontWeight="Medium"/>
                                <TextBlock Text="{Binding autoAmphetawinNote}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,48,0" TextWrapping="Wrap"/>

                                <StackPanel Visibility="{Binding autoAmphetawinEnabled, Converter={StaticResource BoolToVisConverter}}"
                                            Margin="0,16,0,0">
                                    <TextBlock Text="Application" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <DockPanel Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                            <Button Content="Choose App..."
                                                    Click="onChooseAutoAppClicked"
                                                    Style="{StaticResource FluentSecondaryButton}"
                                                    Padding="12,4"/>
                                            <Button Content="Clear"
                                                    Click="onClearAutoAppClicked"
                                                    Style="{StaticResource FluentSecondaryButton}"
                                                    Padding="12,4"
                                                    Margin="8,0,0,0"
                                                    Visibility="{Binding autoAmphetawinHasApp, Converter={StaticResource BoolToVisConverter}}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding autoAmphetawinAppDisplayName}"
                                                   ToolTip="{Binding autoAmphetawinAppPath}"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,12,0"/>
                                    </DockPanel>

                                    <TextBlock Text="Duration" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,18,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Timed"
                                                     GroupName="AutoDurationMode"
                                                     IsChecked="{Binding autoAmphetawinTimed}"
                                                     Style="{StaticResource FluentSegmentedRadio}"/>
                                        <RadioButton Content="Infinite"
                                                     GroupName="AutoDurationMode"
                                                     IsChecked="{Binding autoAmphetawinInfinite}"
                                                     Style="{StaticResource FluentSegmentedRadio}"
                                                     Margin="8,0,0,0"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="0,12,0,0"
                                                Visibility="{Binding autoAmphetawinTimed, Converter={StaticResource BoolToVisConverter}}">
                                        <TextBox Text="{Binding autoAmphetawinDurationValue, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource FluentTextBox}"
                                                 Width="76"
                                                 VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding durationUnitOptions}"
                                                  SelectedItem="{Binding autoAmphetawinDurationUnit, Mode=TwoWay}"
                                                  Style="{StaticResource FluentComboBox}"
                                                  Width="120"
                                                  Margin="8,0,0,0"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding autoAmphetawinBehaviorNote}"
                                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource FluentCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Emergency Fallback" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding emergencyFallbackMinutes, StringFormat='{}{0} minutes'}"
                                               FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                               DockPanel.Dock="Right" TextAlignment="Right"/>
                                </DockPanel>
                                <Slider Minimum="5" Maximum="120" SmallChange="5" LargeChange="15"
                                        Value="{Binding emergencyFallbackMinutes}"
                                        Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{Binding emergencyFallbackNote}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="About">
                <ScrollViewer Style="{StaticResource FluentTabScrollViewer}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource FluentTabDescription}"
                                   Text="App details, version information and update controls."/>
                        <Border Style="{StaticResource FluentCard}">
                            <DockPanel>
                                <Image Source="pack://application:,,,/Assets/LidDock.png" Width="56" Height="56" Margin="0,0,16,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="LidDock" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                    <TextBlock Text="Smart Clamshell Mode for Windows 11" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                    <TextBlock Text="Brings seamless macOS-style Clamshell Mode experience to Windows laptops."
                                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="18"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource FluentCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Version" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding appVersion}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Author" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding author}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="GitHub Repository" FontWeight="Medium" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6">
                                    <Hyperlink NavigateUri="{Binding githubUrl}" RequestNavigate="onHyperlinkRequestNavigate" Foreground="{DynamicResource AccentBrush}">
                                        <TextBlock Text="{Binding githubUrl}"/>
                                    </Hyperlink>
                                </TextBlock>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource FluentCard}">
                            <StackPanel>
                                <TextBlock Text="Software Updates" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <DockPanel Margin="0,0,0,8">
                                    <Button Content="Check for Updates"
                                            Click="onCheckForUpdatesClicked"
                                            IsEnabled="{Binding canCheckForUpdates}"
                                            Style="{StaticResource FluentSecondaryButton}"
                                            Padding="14,6"
                                            DockPanel.Dock="Right"/>
                                    <TextBlock Text="{Binding updateStatusMessage}"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </DockPanel>
                                <StackPanel Visibility="{Binding isUpdateAvailable, Converter={StaticResource BoolToVisConverter}}" Margin="0,2,0,6">
                                    <TextBlock>
                                        <Hyperlink NavigateUri="{Binding latestVersionUrl}" RequestNavigate="onHyperlinkRequestNavigate" Foreground="{DynamicResource AccentBrush}">
                                            <TextBlock Text="Download latest release on GitHub"/>
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                                <CheckBox Content="Automatically check for updates"
                                          IsChecked="{Binding autoCheckForUpdates}"
                                          Style="{StaticResource FluentToggleSwitch}"
                                          Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Diagnostics" MinWidth="130" Margin="0,0,12,0" Click="onDiagnosticsClicked" Style="{StaticResource FluentSecondaryButton}"/>
            <Button Content="Save &amp; Close" MinWidth="130" Click="onCloseClicked" Style="{StaticResource FluentPrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
