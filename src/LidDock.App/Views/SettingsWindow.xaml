<Window x:Class="LidDock.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LidDock Settings" Height="520" Width="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        ResizeMode="NoResize">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="-1"
                      CornerRadius="8"
                      UseAeroCaptionButtons="True"/>
    </WindowChrome.WindowChrome>

    <Grid Margin="20,12,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,4,140,16">
            <TextBlock Text="LidDock Settings" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
            <TextBlock Text="Manage Clamshell mode, display triggers, safety timers and power behavior."
                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" Style="{StaticResource FluentTabControl}">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource FluentCard}">
                            <CheckBox Content="Enable Smart Clamshell Mode"
                                      IsChecked="{Binding enableClamshell}"
                                      Style="{StaticResource FluentToggleSwitch}"
                                      FontWeight="Medium"/>
                        </Border>
                        <Border Style="{StaticResource FluentCard}">
                            <CheckBox Content="Launch automatically when Windows starts"
                                      IsChecked="{Binding startWithWindows}"
                                      Style="{StaticResource FluentToggleSwitch}"/>
                        </Border>
                        <Border Style="{StaticResource FluentCard}">
                            <CheckBox Content="Start minimized to the system notification area"
                                      IsChecked="{Binding startMinimized}"
                                      Style="{StaticResource FluentToggleSwitch}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Profiles">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource FluentCard}">
                            <StackPanel>
                                <RadioButton GroupName="Profiles"
                                             Content="Smart Docked (Recommended)"
                                             IsChecked="{Binding isProfileSmartDocked}"
                                             FontWeight="SemiBold"
                                             Style="{StaticResource FluentRadioButton}"/>
                                <TextBlock Text="Clamshell mode activates automatically when docked and switches back to normal sleep when undocked."
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="24,0,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource FluentCard}">
                            <StackPanel>
                                <RadioButton GroupName="Profiles"
                                             Content="AC Power Only"
                                             IsChecked="{Binding isProfileAcOnly}"
                                             FontWeight="SemiBold"
                                             Style="{StaticResource FluentRadioButton}"/>
                                <TextBlock Text="Clamshell mode is strictly restricted to wall power connection to preserve battery health."
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="24,0,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource FluentCard}">
                            <StackPanel>
                                <RadioButton GroupName="Profiles"
                                             Content="Always Clamshell"
                                             IsChecked="{Binding isProfileAlwaysClamshell}"
                                             FontWeight="SemiBold"
                                             Style="{StaticResource FluentRadioButton}"/>
                                <TextBlock Text="Clamshell mode remains active whenever an external monitor is attached, even on battery."
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="24,0,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource FluentCard}">
                            <RadioButton GroupName="Profiles"
                                         Content="Custom Profile"
                                         IsChecked="{Binding isProfileCustom}"
                                         FontWeight="SemiBold"
                                         Style="{StaticResource FluentRadioButton}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Display Detection">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource FluentCard}">
                            <CheckBox Content="Ignore Virtual Displays (RDP, Parsec, Virtual Drivers)"
                                      IsChecked="{Binding ignoreVirtualDisplays}"
                                      Style="{StaticResource FluentToggleSwitch}"/>
                        </Border>
                        <Border Style="{StaticResource FluentCard}">
                            <CheckBox Content="Ignore Wireless Displays (Miracast)"
                                      IsChecked="{Binding ignoreWirelessDisplays}"
                                      Style="{StaticResource FluentToggleSwitch}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Safety &amp; Delay">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource FluentCard}">
                            <CheckBox Content="Sleep laptop if external display disconnects while lid is closed"
                                      IsChecked="{Binding sleepOnDisconnectWithLidClosed}"
                                      Style="{StaticResource FluentToggleSwitch}"/>
                        </Border>

                        <Border Style="{StaticResource FluentCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Disconnect Grace Delay" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding disconnectDelaySeconds, StringFormat='{}{0} seconds'}"
                                               FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                               DockPanel.Dock="Right" TextAlignment="Right"/>
                                </DockPanel>
                                <Slider Minimum="3" Maximum="30" SmallChange="1" LargeChange="5"
                                        Value="{Binding disconnectDelaySeconds}"
                                        Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource FluentCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Minimum Battery Threshold for Clamshell" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding minimumBatteryThreshold, StringFormat='{}{0}%'}"
                                               FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"
                                               DockPanel.Dock="Right" TextAlignment="Right"/>
                                </DockPanel>
                                <Slider Minimum="5" Maximum="50" SmallChange="1" LargeChange="5"
                                        Value="{Binding minimumBatteryThreshold}"
                                        Foreground="{StaticResource AccentBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="About">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource FluentCard}">
                            <StackPanel>
                                <TextBlock Text="LidDock" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="Smart Clamshell Mode for Windows 11" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                                <TextBlock Text="Brings seamless macOS-style Clamshell Mode experience to Windows laptops."
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource FluentCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Version" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding appVersion}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Author" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding author}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,6"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="GitHub Repository" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6">
                                    <Hyperlink NavigateUri="{Binding githubUrl}" RequestNavigate="onHyperlinkRequestNavigate" Foreground="{StaticResource AccentBrush}">
                                        <TextBlock Text="{Binding githubUrl}"/>
                                    </Hyperlink>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Diagnostics" MinWidth="130" Margin="0,0,12,0" Click="onDiagnosticsClicked" Style="{StaticResource FluentSecondaryButton}"/>
            <Button Content="Save &amp; Close" MinWidth="130" Click="onCloseClicked" Style="{StaticResource FluentPrimaryButton}"/>
        </StackPanel>
    </Grid>
</Window>
