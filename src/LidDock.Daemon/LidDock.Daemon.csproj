<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationManifest>..\LidDock.App\app.manifest</ApplicationManifest>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <EventSourceSupport>false</EventSourceSupport>
    <StackTraceSupport>false</StackTraceSupport>
    <AssemblyName>LidDock</AssemblyName>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <GarbageCollectionAdaptationMode>0</GarbageCollectionAdaptationMode>
    <AutoreleasePoolSupport>false</AutoreleasePoolSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <IlcTrimReflection>true</IlcTrimReflection>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="9" />
    <RuntimeHostConfigurationOption Include="System.Threading.ThreadPool.MinThreads" Value="1" />
    <RuntimeHostConfigurationOption Include="System.Threading.ThreadPool.MaxThreads" Value="4" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\LidDock.UI.exe" LogicalName="LidDock.UI.exe" Condition="Exists('Resources\LidDock.UI.exe')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LidDock.Core\LidDock.Core.csproj" />
    <ProjectReference Include="..\LidDock.Windows\LidDock.Windows.csproj" />
    <ProjectReference Include="..\LidDock.Diagnostics\LidDock.Diagnostics.csproj" />
  </ItemGroup>

</Project>
